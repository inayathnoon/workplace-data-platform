# Anchored to the repo root on purpose. An unanchored `warehouse/` also
# matched src/workplace_platform/warehouse/, which silently excluded a whole
# package from the repo - the build succeeded locally and failed in CI.
/data/
/warehouse/
/out/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

/dbt/target/
/dbt/dbt_packages/
/dbt/logs/
/logs/

.DS_Store
.env

# Test and build output
.coverage
coverage.xml
htmlcov/
/dist/
/build/
*.egg-info/

# Local databases the pipeline writes
*.duckdb
*.duckdb.wal

# Editors and notebooks
.idea/
.vscode/
.ipynb_checkpoints/

# Secrets: .env is already ignored, but the per-profile variants are the ones
# that actually get created and forgotten about.
.env.*
!.env.example
